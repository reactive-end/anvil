{
  "version": 1,
  "stacks": [
    "rust"
  ],
  "tools": [
    "cargo"
  ],
  "subrepos": [
    {
      "name": "anvil",
      "path": ".",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-adapters",
      "path": "crates/anvil-adapters",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-ast",
      "path": "crates/anvil-ast",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-cli",
      "path": "crates/anvil-cli",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-codemode",
      "path": "crates/anvil-codemode",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-core",
      "path": "crates/anvil-core",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-deps",
      "path": "crates/anvil-deps",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-graph",
      "path": "crates/anvil-graph",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-mcp",
      "path": "crates/anvil-mcp",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-memory",
      "path": "crates/anvil-memory",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-qa",
      "path": "crates/anvil-qa",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    },
    {
      "name": "anvil-tasks",
      "path": "crates/anvil-tasks",
      "stacks": [
        "rust"
      ],
      "tools": [
        "cargo"
      ],
      "sonar_enabled": false
    }
  ],
  "tier_budgets": {
    "tier0_ms": 500,
    "tier1_secs": 15,
    "tier1_timeout_secs": 300,
    "compressor_max_lines": 50,
    "compressor_max_tokens": 1200
  },
  "root_allowlist": [
    ".agents",
    ".claude",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".harness",
    ".mcp.json",
    "AGENTS.md",
    "CLAUDE.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "clippy.toml",
    "rustfmt.toml",
    "crates",
    "package.json",
    "scripts",
    "tasks.json",
    "templates",
    "test",
    "tsconfig.json",
    "src"
  ],
  "circuit_breaker_limit": 3,
  "deps_max_age_months": 24,
  "qa_driver": {
    "web": "unconfigured",
    "mobile": "unconfigured"
  },
  "adapters": "all",
  "allowed_escapes": [
    "anvil-allow"
  ],
  "boundaries": [],
  "forbid_import_cycles": false,
  "sonar": {
    "enabled": false,
    "token_env": "SONAR_TOKEN",
    "cognitive_complexity_max": 15,
    "duplication_min_lines": 8
  },
  "token_guard": {
    "max_text_lines": 800,
    "max_read_lines": 400,
    "max_noise_read_lines": 200,
    "max_binary_bytes": 5242880,
    "max_pdf_bytes": 10485760,
    "max_pdf_pages": 20
  },
  "orchestrator": {
    "orchestrator": {
      "model": "opus",
      "effort": "high"
    },
    "executor": {
      "model": "sonnet",
      "effort": "high"
    }
  }
}
