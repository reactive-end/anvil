# A catch that adds context and rethrows.
@@ before src/math.ts
export function total(items: number[]): number {
  let sum = 0;
  for (const item of items) {
    sum += item;
  }
  return sum;
}
@@ before src/main.ts
import { total } from "./math";

export function run(): number {
  return total([1, 2, 3]);
}
@@ after src/main.ts
import { total } from "./math";

export function run(): number {
  try {
    return total([1, 2, 3]);
  } catch (err) {
    throw new Error(`run failed: ${String(err)}`);
  }
}
