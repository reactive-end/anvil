# Deleting the only statement of an old catch empties it without adding a line.
@@ before src/math.ts
export function total(items: number[]): number {
  let sum = 0;
  for (const item of items) {
    sum += item;
  }
  return sum;
}
@@ before src/main.ts
import { total } from "./math";

export function run(): number {
  try {
    return total([1, 2, 3]);
  } catch (err) {
    console.error("run failed", err);
  }
  return 0;
}
@@ after src/main.ts
import { total } from "./math";

export function run(): number {
