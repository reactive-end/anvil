@@ after src/math.ts
export function total(items: number[]): number {
  let sum = 0;
  for (const item of items) {
    sum += item;
  }
  return sum;
}

export function average(items: number[]): number {
  return items.length === 0 ? 0 : total(items) / items.length;
}
@@ after src/main.ts
import { average, total } from "./math";

export function run(): number {
  return total([1, 2, 3]) + average([4, 6]);
}
