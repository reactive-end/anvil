# A loop rewritten as a reduce, same contract.
@@ before src/math.ts
export function total(items: number[]): number {
  let sum = 0;
  for (const item of items) {
    sum += item;
  }
  return sum;
}
@@ before src/main.ts
import { total } from "./math";

export function run(): number {
  return total([1, 2, 3]);
}
@@ after src/math.ts
export function total(items: number[]): number {
  return items.reduce((sum, item) => sum + item, 0);
}
