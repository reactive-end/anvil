# A catch that reports the error before returning its fallback.
@@ before src/math.ts
export function total(items: number[]): number {
  let sum = 0;
  for (const item of items) {
    sum += item;
  }
  return sum;
}
@@ before src/main.ts
import { total } from "./math";

export function run(): number {
  return total([1, 2, 3]);
}
@@ after src/main.ts
import { total } from "./math";

export function run(): number {
  try {
    return total([1, 2, 3]);
  } catch (error) {
    console.warn("total failed", error);
    return 0;
  }
}
