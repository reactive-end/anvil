# A `# type: ignore` hides a type error.
@@ before app/__init__.py
@@ before app/calc.py
def total(items: list[int]) -> int:
    return sum(items)
@@ before app/main.py
from app.calc import total


def run() -> int:
    return total([1, 2, 3])
@@ after app/calc.py
def total(items: list[int]) -> int:
    return sum(items)  # type: ignore
@@ expect
error no-escape-hatches app/calc.py
